# Local development — SQLite (for quick testing)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ============================================================
# PRODUCTION — PostgreSQL via Supabase
# ============================================================
# When deploying to Vercel, set this as the DATABASE_URL
# environment variable in Vercel dashboard:
#
# 1. Go to https://supabase.com → Create free account
# 2. Create a new project (name it "skulhub")
# 3. Go to Settings → Database → Connection string
# 4. Copy the "URI" connection string
# 5. In Vercel → skulhub project → Settings → Environment Variables
# 6. Set DATABASE_URL to the Supabase connection string
# 7. Also set the Prisma schema provider to postgresql
#
# Example Supabase URL:
# DATABASE_URL=postgresql://postgres:YourPassword@db.abcdefg.supabase.co:5432/postgres
